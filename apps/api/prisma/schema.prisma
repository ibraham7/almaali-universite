generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum RoleCode {
  STUDENT
  ADVISOR
  REGISTRAR
  SYSTEM_ADMIN
}

enum ProgramLevel {
  BACHELOR
  DIPLOMA
  MASTER
  DOCTORATE
}

enum CourseType {
  THEORY
  PRACTICAL
  UNSPECIFIED
}

enum CourseRequirement {
  MANDATORY
  ELECTIVE
}

enum StudyPlanCourseStatus {
  ACTIVE
  REMOVED
}

enum CurriculumCategory {
  UNIVERSITY
  COLLEGE
  PROGRAM
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum SectionStatus {
  OPEN
  CLOSED
}

// ACTIVE: مسجّل. DROPPED: مُسقَط (يبقى بسجل الطالب). VOID: عنصر أُلغي لأن العملية التي أنشأته فشلت.
enum EnrollmentItemStatus {
  ACTIVE
  DROPPED
  VOID
}

enum EnrollmentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CONFIRMED
  DROPPED
  CANCELLED
}

model University {
  id     String @id @default(uuid())
  nameAr String
  nameEn String

  minGpaForFutureYears    Decimal @default(2.0)
  // Students register for their current semester only by default. A
  // supervisor can raise this from the system settings screen for a
  // university that wants to allow registering ahead of schedule.
  allowedFutureYears      Int     @default(0)
  requiredElectiveCredits Int     @default(12)

  colleges    College[]
  gradeScales GradeScale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model College {
  id           String  @id @default(uuid())
  universityId String
  nameAr       String
  nameEn       String?
  // رمز الكلية (رقمان): جزء من الرقم الجامعي = السنة + رمز الكلية + التسلسل
  code         String?

  university  University   @relation(fields: [universityId], references: [id])
  departments Department[]
  programs    Program[]
  advisorAssignments AdvisorCollegeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, nameAr])
  @@unique([universityId, code])
}

model Department {
  id        String  @id @default(uuid())
  collegeId String
  nameAr    String
  nameEn    String?

  college  College   @relation(fields: [collegeId], references: [id])
  programs Program[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, nameAr])
}

model Program {
  id           String  @id @default(uuid())
  departmentId String?
  collegeId    String?
  nameAr       String
  nameEn       String?
  // نوع البرنامج: بكالوريوس / دبلوم / ماجستير / دكتوراه. الاسم العربي يُشتق منه.
  level        ProgramLevel @default(BACHELOR)

  department Department? @relation(fields: [departmentId], references: [id])
  college    College?    @relation(fields: [collegeId], references: [id])
  studyPlans StudyPlan[]
  advisorAssignments AdvisorProgramAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, nameAr])
  @@unique([collegeId, nameAr])
}

model StudyPlan {
  id        String  @id @default(uuid())
  programId String
  nameAr    String
  nameEn            String?
  graduationCredits Int?

  program           Program                     @relation(fields: [programId], references: [id])
  academicYears     AcademicYear[]
  planCourses       StudyPlanCourse[]
  curriculumEntries StudyPlanCurriculumCourse[]
  curriculumQuotas  StudyPlanCurriculumQuota[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, nameAr])
}

// حاليًا يمثل المستوى داخل الخطة الدراسية.
// أبقينا اسم AcademicYear حتى لا نكسر الخدمات الحالية.
model AcademicYear {
  id          String  @id @default(uuid())
  studyPlanId String
  nameAr      String
  nameEn      String?

  // ترتيب المستوى داخل الخطة: 1، 2، 3...
  levelNumber Int

  studyPlan   StudyPlan         @relation(fields: [studyPlanId], references: [id])
  semesters   Semester[]
  planCourses StudyPlanCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyPlanId, nameAr])
  @@unique([studyPlanId, levelNumber])
}

model Semester {
  id             String  @id @default(uuid())
  academicYearId String
  nameAr         String
  nameEn         String?

  // ترتيب الفصل داخل المستوى.
  semesterNumber Int

  requireMandatoryCourses Boolean @default(false)
  isActive                Boolean @default(true)

  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  planCourses  StudyPlanCourse[]
  results      CourseResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, nameAr])
  @@unique([academicYearId, semesterNumber])
}

model Role {
  id          String   @id @default(uuid())
  code        RoleCode @unique
  name        String
  description String?
  isActive    Boolean  @default(true)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String?    @unique
  displayName  String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  student Student?
  advisorProgramAssignments AdvisorProgramAssignment[]
  advisorCollegeAssignments AdvisorCollegeAssignment[]
  affairsStaff AffairsStaff?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdvisorProgramAssignment {
  id        String   @id @default(uuid())
  advisorId String
  programId String

  advisor User    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([advisorId, programId])
  @@index([programId])
}

// Assigns an advisor to an entire college: every department and program
// under it, including ones added later, without re-assigning the advisor
// each time. A college assignment and individual program assignments
// (AdvisorProgramAssignment) can both exist for the same advisor; the
// allowed-program set is the union of both.
model AdvisorCollegeAssignment {
  id        String   @id @default(uuid())
  advisorId String
  collegeId String

  advisor User    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([advisorId, collegeId])
  @@index([collegeId])
}

model Student {
  id              String    @id @default(uuid())
  universityId    String    @unique
  firstName       String
  fullName        String?
  middleName      String?
  familyName      String    @default("")
  // رقم المفاضلة: الرقم الذي تولّده الوزارة للطالب (يختلف عن الرقم الجامعي الخاص بالجامعة)
  meritNumber     String?
  motherName      String?
  nationalId      String?
  applicationNumber String?
  birthPlace      String?
  englishName     String?
  gender          String?
  dateOfBirth     DateTime?
  nationality     String?
  idOrPassport    String?
  universityEmail String?
  phone           String?

  collegeId      String?
  departmentId   String?
  programId      String?
  studyPlanId    String?
  academicYearId String?
  semesterId     String?

  status        String
  advisorId     String?
  admissionDate DateTime?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]
  results     CourseResult[]
  numberHistory StudentNumberHistory[]
  affairsRequests StudentRequest[]
  dataChanges     StudentDataChange[]
  documents       IssuedDocument[]
}

model SupportTicket {
  id          String   @id @default(uuid())
  authorId    String
  category    String
  title       String
  description String
  imageData   String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    SupportTicketMessage[]
}

model SupportTicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Teacher {
  id             String  @id @default(uuid())
  name           String
  email          String?
  phone          String?
  qualification  String?
  specialization String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections CourseSection[]
}

model RegistrationPeriod {
  id                      String    @id @default(uuid())
  semesterId              String
  startDateTime           DateTime
  endDateTime             DateTime
  minCredits              Int?
  maxCredits              Int?
  advisorApprovalRequired Boolean   @default(false)
  dropAllowed             Boolean   @default(true)
  addDropDeadline         DateTime?
  reason                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String            @id @default(uuid())
  code        String            @unique
  nameAr      String
  nameEn      String?
  credits     Int
  ects        Decimal?
  type        CourseType
  requirement CourseRequirement
  description String?
  status      CourseStatus      @default(ACTIVE)

  prerequisites   CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredFor     CoursePrerequisite[] @relation("RequiredFor")
  sections        CourseSection[]
  enrollmentItems EnrollmentItem[]
  planCourses       StudyPlanCourse[]
  curriculumEntries StudyPlanCurriculumCourse[]
  results           CourseResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ربط المقرر بالخطة والمستوى والفصل.
// priority للترتيب فقط، وليس prerequisite.
model StudyPlanCourse {
  id             String @id @default(uuid())
  studyPlanId    String
  academicYearId String
  semesterId     String
  courseId       String

  priority    Int
  requirement CourseRequirement

  // إزالة المقرر من الخطة لا تحذفه (سياسة منع الحذف النهائي): تصبح حالته REMOVED مع من وكم وسبب.
  status       StudyPlanCourseStatus @default(ACTIVE)
  removedAt    DateTime?
  removedById  String?
  removeReason String?

  studyPlan    StudyPlan    @relation(fields: [studyPlanId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id])
  course       Course       @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // المقرر المُزال يبقى بصفّه، فلا يتعارض مع التفرّد: أولويته تُنقل لقيمة سالبة بعيدة عند الإزالة،
  // وإعادة إضافة نفس المقرر "تستعيد" صفّه بدل إنشاء صف جديد.
  @@unique([studyPlanId, academicYearId, semesterId, courseId])
  @@unique([studyPlanId, academicYearId, semesterId, priority])
}



// Catalog courses are attached to a program plan before their semester
// placement is decided. This keeps catalog data separate from student-visible
// term-by-term offerings.
model StudyPlanCurriculumCourse {
  id          String             @id @default(uuid())
  studyPlanId String
  courseId    String
  category    CurriculumCategory
  requirement CourseRequirement
  sourceFile  String
  sourceRow   Int?

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyPlanId, courseId, category, requirement])
  @@index([studyPlanId, category])
}

model StudyPlanCurriculumQuota {
  id                 String             @id @default(uuid())
  studyPlanId        String
  category           CurriculumCategory
  requirement        CourseRequirement
  requiredCredits    Int
  offeredPoolCredits Int

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyPlanId, category, requirement])
}

// علاقة المتطلبات السابقة مستقلة عن ترتيب priority.
model CoursePrerequisite {
  id             String @id @default(uuid())
  courseId       String
  prerequisiteId String

  course       Course @relation("CoursePrerequisites", fields: [courseId], references: [id])
  prerequisite Course @relation("RequiredFor", fields: [prerequisiteId], references: [id])

  createdAt DateTime @default(now())

  @@unique([courseId, prerequisiteId])
}

model Classroom {
  id       String @id @default(uuid())
  name     String
  capacity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections CourseSection[]
}

model CourseSection {
  id            String        @id @default(uuid())
  sectionNumber String
  courseId      String
  semesterId    String
  teacherId     String?
  classroomId   String?
  maxCapacity   Int
  enrolledCount Int           @default(0)
  status        SectionStatus @default(OPEN)
  minEnrollment Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course          Course            @relation(fields: [courseId], references: [id])
  teacher         Teacher?          @relation(fields: [teacherId], references: [id])
  classroom       Classroom?        @relation(fields: [classroomId], references: [id])
  schedules       SectionSchedule[]
  enrollmentItems EnrollmentItem[]

  @@unique([courseId, semesterId, sectionNumber])
}

model SectionSchedule {
  id        String @id @default(uuid())
  sectionId String
  day       String
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model StudentEnrollment {
  id            String           @id @default(uuid())
  studentId     String
  semesterId    String
  status        EnrollmentStatus @default(DRAFT)
  revisionCount Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student             @relation(fields: [studentId], references: [id])
  items     EnrollmentItem[]
  approvals AdvisorApproval[]
  messages  EnrollmentMessage[]

  @@unique([studentId, semesterId])
}

model EnrollmentMessage {
  id           String @id @default(uuid())
  enrollmentId String
  senderUserId String
  senderRole   String
  message      String

  createdAt DateTime @default(now())

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
}

model EnrollmentItem {
  id           String @id @default(uuid())
  enrollmentId String
  courseId     String
  sectionId    String

  status       EnrollmentItemStatus @default(ACTIVE)
  droppedAt    DateTime?
  droppedById  String?
  dropReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id])
  section    CourseSection     @relation(fields: [sectionId], references: [id])
  result     CourseResult?

  @@unique([enrollmentId, courseId])
  @@unique([enrollmentId, sectionId])
}

// سلم الدرجات قابل للتعديل بدل افتراض نظام 4.0 أو 5.0.
// كل صف يمثل نطاق درجة واحدًا مثل A / B+ / Pass ... إلخ.
// gradePoint و passed هما القيمتان اللتان يعتمد عليهما حساب GPA والنجاح لاحقًا.
model GradeScale {
  id           String  @id @default(uuid())
  universityId String
  label        String
  minScore     Decimal
  maxScore     Decimal
  gradePoint   Decimal
  passed       Boolean
  isActive     Boolean @default(true)

  university University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  results    CourseResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, label])
  @@index([universityId, minScore, maxScore])
}

// نتيجة مقرر واحدة مرتبطة بمحاولة التسجيل نفسها.
// نخزن gradePoint و passed كلقطة تاريخية حتى لا تتغير النتائج القديمة
// إذا تم تعديل سلم الدرجات في المستقبل.
model CourseResult {
  id               String  @id @default(uuid())
  enrollmentItemId String  @unique
  studentId        String
  courseId         String
  semesterId       String
  gradeScaleId     String?

  score      Decimal
  gradeLabel String
  gradePoint Decimal
  passed     Boolean

  enrollmentItem EnrollmentItem @relation(fields: [enrollmentItemId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id])
  course         Course         @relation(fields: [courseId], references: [id])
  semester       Semester       @relation(fields: [semesterId], references: [id])
  gradeScale     GradeScale?    @relation(fields: [gradeScaleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([studentId, semesterId])
}

model AdvisorApproval {
  id           String  @id @default(uuid())
  enrollmentId String
  advisorId    String
  status       String
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id       String  @id @default(uuid())
  action   String
  entity   String
  entityId String?
  userId   String?
  details  String?

  createdAt DateTime @default(now())
}

model SignupAttempt {
  id        String   @id @default(uuid())
  ipHash    String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// الأرقام الجامعية السابقة للطالب (تتغير عند النقل بين الكليات). لا تُحذف ولا يُعاد إصدارها،
// وكل سجلات الطالب مرتبطة بمعرّفه الداخلي فتبقى سليمة.
model StudentNumberHistory {
  id                     String   @id @default(uuid())
  studentId              String
  universityId           String   @unique
  collegeId              String?
  replacedByUniversityId String
  reason                 String?
  changedById            String?
  validFrom              DateTime
  validTo                DateTime @default(now())
  createdAt              DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

// ===== Student Affairs (phase 1): services, staff, requests. No hard delete: status fields instead. =====
enum StudentRequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_COMPLETION
  REFERRED
  COMPLETED
  REJECTED
  CANCELLED
  ACCEPTED
}

enum RequestChannel {
  ONLINE
  IN_PERSON
}

enum ServiceChannel {
  ONLINE
  IN_PERSON
  BOTH
}

enum ServiceOutcome {
  NONE
  DOCUMENT
  ACTION
  BOTH
}

enum ReferralTarget {
  ACADEMIC_AFFAIRS
  FINANCIAL_AFFAIRS
  COLLEGE
  OTHER
}

enum ReferralMode {
  OPINION
  EXECUTION
}

enum ReferralStatus {
  PENDING
  ANSWERED
  CANCELLED
}

enum ReferralOutcome {
  APPROVED
  REJECTED
  NOTES
  DONE
  NOT_DONE
}

model AffairsService {
  id             String  @id @default(uuid())
  code           String  @unique
  nameAr         String
  description    String?
  isActive       Boolean @default(true)
  expectedDays   Int     @default(5)
  specialization String?
  // Service setup (phase 2): how it is submitted, what is required, fee, result and workflow (plain text, shown to staff and students).
  channel        ServiceChannel @default(BOTH)
  outcome        ServiceOutcome @default(NONE)
  attachmentsNote String?
  feeNote        String?
  workflowNote   String?
  // Document issued by this service (phase 3).
  documentTypeId String?
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id])

  staff    AffairsStaffService[]
  requests StudentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffairsStaff {
  id             String  @id @default(uuid())
  userId         String  @unique
  specialization String?
  isActive       Boolean @default(true)

  user     User                  @relation(fields: [userId], references: [id])
  services AffairsStaffService[]
  requests StudentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffairsStaffService {
  staffId   String
  serviceId String
  // Removing a service from a staff member switches this off (rows are never deleted).
  isActive  Boolean @default(true)

  staff   AffairsStaff   @relation(fields: [staffId], references: [id])
  service AffairsService @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
}

// Per-year counter for request numbers (SR-YY-NNNN); a number is never reused.
model AffairsRequestCounter {
  year Int @id
  last Int @default(0)
}

model StudentRequest {
  id              String               @id @default(uuid())
  number          String               @unique
  studentId       String
  serviceId       String
  status          StudentRequestStatus @default(NEW)
  assignedStaffId String?
  subject         String?
  details         String?
  createdByUserId String?
  dueAt           DateTime?
  closedAt        DateTime?
  decisionReason  String?
  channel         RequestChannel       @default(ONLINE)

  student       Student               @relation(fields: [studentId], references: [id])
  service       AffairsService        @relation(fields: [serviceId], references: [id])
  assignedStaff AffairsStaff?         @relation(fields: [assignedStaffId], references: [id])
  events        StudentRequestEvent[]
  attachments   StudentRequestAttachment[]
  referrals     RequestReferral[]
  documents     IssuedDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedStaffId])
  @@index([studentId])
  @@index([createdAt])
}

model StudentRequestEvent {
  id               String                @id @default(uuid())
  requestId        String
  type             String // CREATED | ASSIGNED | REASSIGNED | STATUS_CHANGED | COMMENT
  fromStatus       StudentRequestStatus?
  toStatus         StudentRequestStatus?
  note             String?
  visibleToStudent Boolean               @default(false)
  actorUserId      String?
  staffId          String?
  createdAt        DateTime              @default(now())

  request StudentRequest @relation(fields: [requestId], references: [id])

  @@index([requestId, createdAt])
}

// Files attached to a request. The bytes live in the database (backed up with it) and are only
// served through authenticated endpoints; rows are archived, never deleted.
model StudentRequestAttachment {
  id               String   @id @default(uuid())
  requestId        String
  fileName         String
  mimeType         String
  sizeBytes        Int
  data             Bytes
  visibleToStudent Boolean  @default(false)
  uploadedByUserId String?
  isArchived       Boolean  @default(false)
  archivedReason   String?
  createdAt        DateTime @default(now())

  request StudentRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
}

// A request sent to another body (scientific / financial affairs, college, other) for an opinion or for execution.
model RequestReferral {
  id               String          @id @default(uuid())
  requestId        String
  mode             ReferralMode
  target           ReferralTarget
  targetName       String?
  reason           String
  requested        String?
  dueAt            DateTime?
  status           ReferralStatus  @default(PENDING)
  referredByUserId String?
  outcome          ReferralOutcome?
  responseNote     String?
  respondedByUserId String?
  respondedAt      DateTime?
  cancelReason     String?

  request StudentRequest @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([status])
}

// Who changed which student field, when, from what to what.
model StudentDataChange {
  id              String   @id @default(uuid())
  studentId       String
  field           String
  oldValue        String?
  newValue        String?
  changedByUserId String?
  createdAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

// ===== Student Affairs (phase 3): official documents. Never deleted: revoked with a reason. =====
enum DocumentStatus {
  ACTIVE
  REVOKED
}

// A kind of document the university issues, with its wording. The page layout is the same official template for all.
model DocumentType {
  id              String  @id @default(uuid())
  code            String  @unique
  nameAr          String
  titleAr         String
  issuingBody     String
  // Text with {{placeholders}} (studentName, universityId, college, department, program, status, date).
  bodyTemplate    String
  footerNote      String?
  includesResults Boolean @default(false)
  isActive        Boolean @default(true)

  documents IssuedDocument[]
  services  AffairsService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// payload is a snapshot of everything printed on the document, so it never changes after issue.
model IssuedDocument {
  id               String         @id @default(uuid())
  number           String         @unique
  verificationCode String         @unique
  typeId           String
  studentId        String
  requestId        String?
  status           DocumentStatus @default(ACTIVE)
  payload          Json
  issuedByUserId   String?
  issuedAt         DateTime       @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  revokedByUserId  String?

  type    DocumentType    @relation(fields: [typeId], references: [id])
  student Student         @relation(fields: [studentId], references: [id])
  request StudentRequest? @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([requestId])
  @@index([status])
}

model DocumentCounter {
  year Int @id
  last Int @default(0)
}

// ===== Student Affairs (phase 4): settings and capability switches inside the fixed roles. =====
// One row per setting key; the defaults live in code. Rows are never deleted (the value is overwritten).
model AffairsSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}
