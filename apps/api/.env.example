# Keep test-only numeric logins disabled outside local development.
ENABLE_TEST_LOGINS=false
ENABLE_DEMO_SEED=false

# The demo seed requires these local-only values after explicitly enabling it.
TEST_STUDENT_EMAIL=student@example.test
TEST_STUDENT_PASSWORD=replace-with-a-unique-local-password
TEST_ADVISOR_EMAIL=advisor@example.test
TEST_ADVISOR_PASSWORD=replace-with-a-unique-local-password
TEST_ADMIN_EMAIL=admin@example.test
TEST_ADMIN_PASSWORD=replace-with-a-unique-local-password

# Set these in your local .env; do not commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/university_system
JWT_SECRET=replace-with-a-long-random-local-secret
